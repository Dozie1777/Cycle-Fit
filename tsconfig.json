{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [
			"@types/node",
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-plugin/types",
			"vite/client"
		],
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"worker-configuration.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/**/*.ts",
		"test/**/*.tsx",
		"scripts/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
