{
	"name": "code-review-bot",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.0.0",
	"description": "GitHub App worker: sandboxed PR reviews, design studio, campaign planning workspaces, and browser/terminal operator tools on Cloudflare",
	"scripts": {
		"lint": "biome lint --max-diagnostics 10000",
		"lint:write": "biome check --write --max-diagnostics 10000",
		"format": "biome format --max-diagnostics 10000",
		"format:write": "biome format --write --max-diagnostics 10000",
		"deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
		"dev": "prisma generate && vite dev",
		"start": "vite preview",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars false",
		"typecheck": "prisma generate && tsc --noEmit",
		"test": "prisma generate && vitest run --project unit",
		"test:workers": "prisma generate && vitest run --project workers",
		"verify:build": "node scripts/verify-build.mjs",
		"db:generate": "prisma generate",
		"db:generate:actors": "find src/server/rivet/actors -name drizzle.config.ts -exec drizzle-kit generate --config {} \\;",
		"db:migration-diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
		"db:migrate-local": "wrangler d1 migrations apply DB --local",
		"db:migrate-remote": "wrangler d1 migrations apply DB --remote",
		"auth:generate": "npx @better-auth/cli generate --config src/lib/auth.generate.ts -y"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.2.12",
		"@biomejs/biome": "2.4.16",
		"@cloudflare/sandbox": "^0.12.7",
		"@cloudflare/vite-plugin": "^1.65.0",
		"@cloudflare/vitest-plugin": "1.4.7",
		"@types/node": "^24.10.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-test-renderer": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dotenv": "16.6.1",
		"drizzle-kit": "^0.31.2",
		"prisma": "7.10.1",
		"react-test-renderer": "19.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.152.0",
		"workerd": "1.20261019.1"
	},
	"author": "",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0 <=24.x.x"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^2.0.79",
		"@ai-sdk/provider": "3.0.8",
		"@ai-sdk/react": "^3.0.314",
		"@base-ui/react": "^1.9.0",
		"@cloudflare/playwright": "^1.3.6",
		"@cloudflare/playwright-mcp": "^0.0.5",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@prisma/adapter-d1": "7.10.1",
		"@prisma/client": "7.10.1",
		"@radix-ui/react-use-controllable-state": "^1.2.2",
		"@rivetkit/cloudflare-workers": "2.2.1",
		"@rivetkit/react": "2.2.1",
		"@shadcn/react": "^0.3.1",
		"@streamdown/cjk": "^1.0.4",
		"@streamdown/code": "^2.0.0",
		"@streamdown/math": "^1.0.3",
		"@streamdown/mermaid": "^1.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.81.5",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"@tanstack/router-devtools": "^1.167.2",
		"@tiptap/core": "3.33.0",
		"@tiptap/extension-table": "3.33.0",
		"@tiptap/markdown": "3.33.0",
		"@tiptap/pm": "3.33.0",
		"@tiptap/react": "3.33.0",
		"@tiptap/starter-kit": "3.33.0",
		"@trpc/client": "^11.23.0",
		"@trpc/server": "^11.23.0",
		"ai": "^6.0.154",
		"aws4fetch": "^1.0.20",
		"better-auth": "1.6.1",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.0",
		"drizzle-orm": "^0.37.0",
		"lucide-react": "^0.487.0",
		"motion": "^12.6.3",
		"nanoid": "^5.1.5",
		"octokit": "^5.0.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.14.8",
		"rivetkit": "2.2.1",
		"shadcn": "^4.22.1",
		"shiki": "^4.5.0",
		"streamdown": "^1.2.0",
		"tailwindcss": "^4.3.3",
		"workers-ai-provider": "^3.1.12",
		"zod": "^3.25.67"
	},
	"pnpm": {
		"overrides": {
			"@floating-ui/dom": "1.8.0",
			"esbuild": "0.25.12",
			"react-is": ">=19.0.0"
		},
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@rivetkit/cloudflare-workers",
			"@rivetkit/core",
			"@swc/core",
			"@tailwindcss/oxide",
			"esbuild",
			"prisma",
			"protobufjs",
			"unrs-resolver",
			"workerd"
		],
		"patchedDependencies": {
			"@rivetkit/cloudflare-workers@2.2.1": "patches/@rivetkit__cloudflare-workers@2.2.1.patch",
			"@cloudflare/vitest-plugin@1.4.7": "patches/@cloudflare__vitest-plugin@1.4.7.patch",
			"@cloudflare/playwright-mcp@0.0.5": "patches/@cloudflare__playwright-mcp@0.0.5.patch"
		}
	}
}
